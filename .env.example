# =============================================
# BrandVortix Pol — Environment Variables
# =============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Providers ---
GEMINI_API_KEY=your-gemini-key
AI_PROVIDER=gemini
# Claude (optional — used for strategic agent)
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# --- Scraping & Data ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=brandvortix_scraper
SOCIALDATA_API_KEY=
YOUTUBE_API_KEY=
SERPAPI_KEY=

# --- Media Processing ---
OPENAI_API_KEY=
SHOTSTACK_API_KEY=
FIRECRAWL_API_KEY=

# --- Video Worker (Railway) ---
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=

# --- Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Cron Jobs ---
CRON_SECRET=

# --- Social Publisher OAuth (optional) ---
TOKEN_ENCRYPTION_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Perplexity (optional) ---
PERPLEXITY_API_KEY=
