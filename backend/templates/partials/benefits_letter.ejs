<% if (section && section.content.items) { %>
    <section class="section">
        <div class="container">
            <h2>
                <%= section.content.title || 'Beneficios' %>
            </h2>
            <ul class="benefits-list">
                <% section.content.items.forEach(item=> { %>
                    <li>
                        <%= typeof item==='string' ? item : item.title %>
                    </li>
                    <% }) %>
            </ul>
        </div>
    </section>
    <% } %>