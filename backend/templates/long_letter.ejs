<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= meta.seo_title || project.name %>
    </title>
    <% if (meta.favicon) { %>
        <link rel="icon" href="<%= meta.favicon %>">
        <% } %>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link
                href="https://fonts.googleapis.com/css2?family=<%= brand.typography?.headings?.family || 'Rajdhani' %>:wght@400;600;700&family=<%= brand.typography?.body?.family || 'Montserrat' %>:wght@300;400;500;600&display=swap"
                rel="stylesheet">
            <%- include('partials/tracking', { meta }) %>
                <style>
                    :root {
                        --color-bg: <%=pageColors.bg %>;
                        --color-bg-alt: <%=pageColors.bgAlt %>;
                        --color-text: <%=pageColors.text %>;
                        --color-text-muted: <%=pageColors.textMuted %>;
                        --color-primary: <%=pageColors.primary %>;
                        --color-secondary: <%=pageColors.secondary %>;
                        --color-accent: <%=pageColors.accent %>;
                        --color-border: <%=pageColors.border %>;
                        --font-heading: '<%= brand.typography?.headings?.family || ' Rajdhani' %>', sans-serif;
                        --font-body: '<%= brand.typography?.body?.family || ' Montserrat' %>', sans-serif;
                        --radius: <%=brand.border_radius || '8px' %>;

                        /* Spacing System (4px Grid) */
                        --space-xs: 4px;
                        --space-sm: 8px;
                        --space-md: 16px;
                        --space-lg: 24px;
                        --space-xl: 32px;
                        --space-2xl: 48px;
                        --space-3xl: 64px;
                        --space-4xl: 96px;

                        /* Semantic Spacing */
                        --section-padding-y: var(--space-4xl);
                        --element-gap: var(--space-xl);
                        --container-padding: var(--space-lg);
                    }

                    * {
                        margin: 0;
                        padding: 0;
                        box-sizing: border-box;
                    }

                    body {
                        background: var(--color-bg);
                        color: var(--color-text);
                        font-family: var(--font-body);
                        line-height: 1.8;
                    }

                    .container {
                        max-width: 750px;
                        margin: 0 auto;
                        padding: 0 var(--container-padding);
                    }

                    .hero-letter {
                        padding: var(--section-padding-y) var(--container-padding);
                        text-align: center;
                    }

                    .hero-letter .eyebrow {
                        color: var(--color-secondary);
                        text-transform: uppercase;
                        letter-spacing: 3px;
                        font-size: 0.85rem;
                        font-weight: 600;
                        margin-bottom: 12px;
                    }

                    .hero-letter h1 {
                        font-family: var(--font-heading);
                        font-size: clamp(2rem, 5vw, 3rem);
                        font-weight: 700;
                        line-height: 1.15;
                        margin-bottom: 20px;
                        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                    }

                    .hero-letter .lead {
                        font-size: 1.15rem;
                        color: var(--color-text-muted);
                        max-width: 600px;
                        margin: 0 auto;
                    }

                    .story-block {
                        padding: var(--section-padding-y) var(--container-padding);
                    }

                    .story-block .container {
                        font-size: 1.05rem;
                        color: var(--color-text-muted);
                    }

                    .story-block .container p {
                        margin-bottom: 20px;
                    }

                    .story-block .container strong {
                        color: var(--color-text);
                    }

                    .story-block .container em {
                        color: var(--color-secondary);
                        font-style: normal;
                        font-weight: 600;
                    }

                    .section {
                        padding: var(--section-padding-y) var(--container-padding);
                    }

                    .section h2 {
                        font-family: var(--font-heading);
                        font-size: 2rem;
                        text-align: center;
                        margin-bottom: 30px;
                        color: var(--color-primary);
                    }

                    .benefits-list {
                        list-style: none;
                        max-width: 600px;
                        margin: 0 auto;
                    }

                    .benefits-list li {
                        padding: 12px 0;
                        border-bottom: 1px solid var(--color-border);
                        color: var(--color-text-muted);
                    }

                    .benefits-list li::before {
                        content: '✓ ';
                        color: var(--color-secondary);
                        font-weight: 700;
                    }

                    .testimonial {
                        background: var(--color-bg-alt);
                        border-left: 4px solid var(--color-primary);
                        border-radius: var(--radius);
                        padding: var(--space-xl);
                        margin-bottom: var(--space-md);
                    }

                    .testimonial p {
                        color: var(--color-text-muted);
                        font-style: italic;
                    }

                    .testimonial .author {
                        color: var(--color-secondary);
                        font-weight: 600;
                        margin-top: var(--space-sm);
                        font-style: normal;
                    }

                    .urgency-banner {
                        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
                        padding: var(--space-2xl) var(--container-padding);
                        text-align: center;
                        color: #fff;
                        font-family: var(--font-heading);
                        font-size: 1.3rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 2px;
                    }

                    .pricing-simple {
                        text-align: center;
                        padding: var(--section-padding-y) var(--container-padding);
                    }

                    .pricing-simple .price {
                        font-family: var(--font-heading);
                        font-size: 3rem;
                        color: var(--color-secondary);
                        font-weight: 700;
                    }

                    .pricing-simple .price span {
                        font-size: 1rem;
                        color: var(--color-text-muted);
                    }

                    .cta-button {
                        display: inline-block;
                        padding: var(--space-md) var(--space-2xl);
                        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
                        color: #fff;
                        text-decoration: none;
                        border-radius: var(--radius);
                        font-weight: 700;
                        font-size: 1.1rem;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        transition: transform 0.3s, box-shadow 0.3s;
                        cursor: pointer;
                        border: none;
                    }

                    .cta-button:hover {
                        transform: scale(1.05);
                        box-shadow: 0 0 30px rgba(255, 0, 127, 0.4);
                    }

                    .faq {
                        padding: var(--section-padding-y) var(--container-padding);
                        max-width: 700px;
                        margin: 0 auto;
                    }

                    .faq h2 {
                        font-family: var(--font-heading);
                        font-size: 2rem;
                        text-align: center;
                        margin-bottom: 30px;
                        color: var(--color-primary);
                    }

                    .faq-item {
                        background: var(--color-bg-alt);
                        border: 1px solid var(--color-border);
                        border-radius: var(--radius);
                        margin-bottom: 12px;
                    }

                    .faq-item summary {
                        padding: var(--space-md) var(--space-lg);
                        cursor: pointer;
                        font-weight: 600;
                        font-family: var(--font-heading);
                    }

                    .faq-item p {
                        padding: 0 var(--space-lg) var(--space-md);
                        color: var(--color-text-muted);
                    }

                    .brand-logo-container {
                        text-align: center;
                        padding: var(--space-sm) var(--container-padding);
                        width: 100%;
                    }

                    .brand-logo-img {
                        max-height: 240px;
                        max-width: min(90%, 500px);
                        width: auto;
                        height: auto;
                        object-fit: contain;
                        display: inline-block;
                    }
                </style>
</head>

<body>
    <% if (brand.logoPath) { %>
        <div class="brand-logo-container">
            <img src="<%= brand.logoPath %>" alt="Logo" class="brand-logo-img">
        </div>
        <% } %>

            <% sections.filter(s=> s.isVisible !== false && s.visible !== false).forEach(section => { %>
                <% if (section.id==='hero' || section.type==='hero_letter' ) { %>
                    <%- include('partials/hero_letter', { section }) %>
                        <% } else if (section.id==='story' || section.type==='story' ) { %>
                            <%- include('partials/story', { section }) %>
                                <% } else if (section.id==='solution' || section.type==='solution' ) { %>
                                    <%- include('partials/solution', { section }) %>
                                        <% } else if (section.id==='benefits' || section.type==='benefits' ||
                                            section.type==='benefits_letter' ) { %>
                                            <%- include('partials/benefits_letter', { section }) %>
                                                <% } else if (section.id==='testimonials' ||
                                                    section.type==='testimonials' ) { %>
                                                    <%- include('partials/testimonials', { section }) %>
                                                        <% } else if (section.id==='urgency' || section.type==='urgency'
                                                            ) { %>
                                                            <%- include('partials/urgency', { section }) %>
                                                                <% } else if (section.id==='offer' ||
                                                                    section.type==='offer' ) { %>
                                                                    <%- include('partials/offer_letter', { section }) %>
                                                                        <% } else if (section.id==='faq' ||
                                                                            section.type==='faq' ) { %>
                                                                            <%- include('partials/faq', { section }) %>
                                                                                <% } else if
                                                                                    (section.type==='optin_form' ||
                                                                                    section.id==='optin' ||
                                                                                    section.id==='lead_capture' ) { %>
                                                                                    <%- include('partials/optin_form', {
                                                                                        section, sections, pageColors,
                                                                                        project: (typeof project
                                                                                        !=='undefined' ? project : {id:
                                                                                        0}) }) %>
                                                                                        <% } else if
                                                                                            (section.type==='countdown'
                                                                                            || section.id==='countdown'
                                                                                            ) { %>
                                                                                            <%- include('partials/countdown',
                                                                                                { section, sections,
                                                                                                pageColors }) %>
                                                                                                <% } else if
                                                                                                    (section.type==='html_embed'
                                                                                                    ) { %>
                                                                                                    <%- include('partials/html_embed',
                                                                                                        { section }) %>
                                                                                                        <% } else if
                                                                                                            (section.id==='whatsapp'
                                                                                                            ) { %>
                                                                                                            <%- include('partials/whatsapp',
                                                                                                                {
                                                                                                                section
                                                                                                                }) %>
                                                                                                                <% } %>
                                                                                                                    <% });
                                                                                                                        %>
</body>

</html>